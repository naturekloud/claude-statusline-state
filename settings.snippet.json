{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 1
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh start", "timeout": 5 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh running", "timeout": 5 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh running", "timeout": 5 } ] }
    ],
    "PostToolUseFailure": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh running", "timeout": 5 } ] }
    ],
    "PermissionDenied": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh running", "timeout": 5 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh approval", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion", "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh approval", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh idle", "timeout": 5 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh idle", "timeout": 5 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/status-state.sh end", "timeout": 5 } ] }
    ]
  }
}
